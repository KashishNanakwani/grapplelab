# Backend environment variables. Copy to .env and fill in real values.
# Do not commit real secrets.

# Supabase project URL (same project as the frontend).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key. The backend forwards the caller's JWT so
# Row Level Security enforces ownership — no service-role key needed.
SUPABASE_ANON_KEY=

# Allowed CORS origin(s) for the Next.js frontend. Comma-separated; browsers
# treat localhost and 127.0.0.1 as different origins. Defaults to both on
# port 3000 if unset. In production set this to the exact Vercel origin.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- AI coach (Google Gemini) ------------------------------------------
# Google AI Studio -> Get API key. Free tier.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite, which is free-tier and one of
# the two models Google recommends for new projects. Note gemini-1.5-flash
# and gemini-2.0-flash no longer exist, and gemini-2.5-* is restricted to
# projects that already used it.
GEMINI_MODEL=

# Optional, local dev only. The AI coach is a `pro` feature; set this to
# "true" to let a free-tier account use it without editing the database.
# Leave unset in production so the tier gate is enforced.
ALLOW_FREE_TIER_COACH=
